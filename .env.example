# Copy to apps/api/.env and fill in. Never commit real keys.

# --- Free AI providers (zero cost). Tried in this order; set any you have. ---
# One account per provider: creating extra accounts to stretch a free tier breaks their terms.
# Free tiers may use prompts for training: the demo only uses sample data.
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GEMINI_MODEL=          # default: gemini-3.8-flash
GROQ_API_KEY=          # https://console.groq.com/keys
GROQ_MODEL=            # default: qwen/qwen3.8-27b
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
OPENROUTER_MODEL=      # required for OpenRouter: a model id ending in :free
# Claude is not used by the server; users can connect their own key in the app.

# --- Protect the hosted demo ---
SNAGWISE_ACCESS_CODE=          # if set, the app asks for it (put it in the Devpost testing instructions)
SNAGWISE_AGENT_PER_IP_HOUR=30  # agent messages per visitor per hour
SNAGWISE_AGENT_PER_DAY=300     # free-provider messages per day, all visitors together

# --- PayPal: SANDBOX credentials only ---
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Product search: https://trychannel3.com (free tier: 1,000 searches/month) ---
CHANNEL3_API_KEY=
SNAGWISE_PRICE_WATCH_HOURS=6   # background re-check of wallet prices (needs Channel3); 0 turns it off

# --- SnagSkills ---
# SNAGWISE_SKILLS=             # folder with community skills; defaults to the repo's skills/

PORT=8080
