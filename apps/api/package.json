{
  "name": "@snagwise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts src/seed-demo.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env dist/main.mjs",
    "start": "node dist/main.mjs",
    "demo": "node dist/seed-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@hono/node-server": "2.1.5",
    "@snagwise/core": "*",
    "hono": "4.13.13",
    "zod": "4.6.7"
  }
}
